# ClashKing Dashboard - Environment Variables

# API Configuration
# Local development calls the Go API directly on the same localhost site.
# Production builds override this with the deployed API origin.
NEXT_PUBLIC_CLASHKING_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_CLASHKING_AI_ORIGIN=http://localhost:8788

# Discord OAuth2 Client ID
# Use ClashKing bot CLIENT_ID or get yours from Discord Developer Portal: https://discord.com/developers/applications
NEXT_PUBLIC_DISCORD_CLIENT_ID=824653933347209227
