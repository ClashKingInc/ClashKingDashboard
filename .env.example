# ClashKing Dashboard - Environment Variables

# API Configuration
# Local development calls the API Worker directly. Production builds pin the
# deployed origins through the build:production script.
VITE_CLASHKING_API_ORIGIN=http://localhost:8000
VITE_CLASHKING_AI_ORIGIN=http://localhost:8788

# Discord OAuth2 Client ID
# Use ClashKing bot CLIENT_ID or get yours from Discord Developer Portal: https://discord.com/developers/applications
VITE_DISCORD_CLIENT_ID=824653933347209227
