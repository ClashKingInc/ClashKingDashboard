{
  "name": "clashking-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=26.1.0",
    "npm": ">=12.0.1"
  },
  "scripts": {
    "dev": "vinext dev --port 3002",
    "build": "npm run validate:messages && vinext build && node scripts/postprocess-static-html.mjs",
    "build:production": "NEXT_PUBLIC_API_URL=https://v2-api.clashk.ing NEXT_PUBLIC_DISCORD_CLIENT_ID=824653933347209227 npm run build",
    "start": "vinext start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "validate:messages": "node scripts/validate-messages.mjs",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "preview": "wrangler dev",
    "worker:types": "wrangler types --config wrangler.deploy.jsonc",
    "deploy": "npm run build:production && wrangler deploy --config wrangler.deploy.jsonc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
